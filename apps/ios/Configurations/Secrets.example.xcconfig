// Copy to Secrets.Dev.xcconfig / Secrets.Prod.xcconfig (both gitignored) and fill in.
// The anon key is public but is kept out of the repo; tests do not need real values.
// Write the URL as https:/$()/<project>.supabase.co ("//" starts an xcconfig comment).
SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY
